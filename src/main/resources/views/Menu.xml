<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

  <!-- MyRH -->

 
  <menuitem name="n2f-all-expense"  title="Expenses" action="expense.all"
    order="10" if="__config__.app.isApp('expense')" icon="list-task" icon-background="#84429f"/>

  <!-- Expense app -->

   <menuitem name="n2f-validate-expense" title="Expenses to Validate"
    action="expense.validate" tag-style="default"
    tag-get="com.axelor.apps.hr.web.expense.ExpenseController:expenseValidateMenuTag()" order="100"/>

  <menuitem name="n2f-ventilate-expense"   title="Expenses to Ventilate"
    action="expense.ventilate" tag-count="true" order="200"/>

      <menuitem name="n2f-historic-expense"   title="Historic team Expenses"
    action="expense.historic" order="300"/>
    
      <menuitem name="n2f-admin-root-user-user"  title="Users"  action="n2f-action-auth-users" order="400"/>

  <action-view  name="n2f-action-auth-users" title="Users"     model="com.axelor.auth.db.User">
    <view type="grid" name="ndf-user-grid"/>
    <view type="form" name="ndf-user-form"/>
    <view-param name="search-filters" value="user-filters"/>
    <context name="_today" expr="eval: __config__.date"/>
    <context name="_showRecord" expr="eval: userId" if="userId"/>
  </action-view>


      
 
          <menuitem name="n2f-product-root-service"   title="Products.services" action="n2f-product.root.service" order="500"/>

  <action-view name="n2f-product.root.service" title="Products.services"
    model="com.axelor.apps.base.db.Product"> 
    <view type="grid" name="ndf-product-grid"/>
    <view type="form" name="ndf-product-form"/>
    <view-param name="limit" value="39"/>
    <view-param name="search-filters" value="products-filters"/>
    <domain>self.activeCompany = :activeCompany AND self.isModel = :_isModel AND self.productTypeSelect = :_productTypeSelect AND self.dtype = 'Product' AND self.productFamily = :_productFamily</domain>
    <context name="activeCompany" expr="eval: __user__.activeCompany"/>
    <context name="_isModel" expr="false"/>
    <context name="_productTypeSelect" expr="service"/>
     <context name="_productFamily" expr="eval:__repo__(ProductFamily).all().filter('id = ?1',6).fetchOne()"/>
     <context name="_productCategory" expr="eval:__repo__(ProductCategory).all().filter('id = ?1',13).fetchOne()"/>
     
  </action-view>

    



      <menuitem name="n2f-admin-root-user-company"   title="Companies"   action="n2f-admin.root.base.company" order="600"/>
    
 <action-view name="n2f-admin.root.base.company" title="Companies"  model="com.axelor.apps.base.db.Company"> 
 <view type="grid" name="ndf-company-grid"   if="__config__.app.getApp('base')?.getEnableMultiCompany()"/>
    <view type="form" name="ndf-company-form"/>
    <view-param name="search-filters" value="company-filters"/>
    <context name="_showRecord" expr="eval:__repo__(Company).all().fetchOne()?.getId()"  if="!__config__.app.getApp('base')?.getEnableMultiCompany()"/>
    <context name="_canNew"  expr="eval:false"/>
  </action-view>

</object-views>
